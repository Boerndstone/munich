{# Compact header for area rock listings. Detailed area information stays in the existing menu/dialogs. #}

{% set areaHeroActions = [] %}
{% if areaKletterkonzeption %}
	{% set areaHeroActions = areaHeroActions|merge([{
		icon: 'lucide:info',
		label: 'area.hero.kletterkonzeption',
		modal: 'kletterkonzeptionModal'
	}]) %}
{% endif %}
{% if top100Routes is not empty %}
	{% set areaHeroActions = areaHeroActions|merge([{
		icon: 'lucide:database-arrow-up',
		label: 'area.hero.top100',
		modal: 'top100RoutesModal'
	}]) %}
{% endif %}
{% set areaHeroActions = areaHeroActions|merge([{
	icon: 'lucide:map',
	label: 'area.hero.overview_map',
	modal: 'modalAreaMap',
	load_map: true
}]) %}

	<div class="flex min-w-0 flex-1 items-center justify-between gap-3">
		<h1 class="m-0 min-w-0 truncate text-2xl font-medium tracking-tight sm:text-3xl">
			{{ areaName }}
		</h1>
		<details id="areaHeroMoreMenu" class="group relative shrink-0">
			<summary class="inline-flex size-8 list-none cursor-pointer items-center justify-center rounded-md border border-border bg-background text-foreground shadow-xs outline-none hover:bg-muted focus-visible:ring-2 focus-visible:ring-ring [&::-webkit-details-marker]:hidden" aria-label="{{ 'area.hero.more_menu_aria'|trans }}">
				<twig:ux:icon name="lucide:info" class="size-4" aria-hidden="true" />
			</summary>
			<div class="absolute end-0 z-[1080] mt-1 min-w-[12rem] rounded-md border border-border bg-popover p-1 text-popover-foreground shadow-md outline-none" role="menu" aria-orientation="vertical">
				<ul class="m-0 list-none p-0">
					{% for action in areaHeroActions %}
						<li role="none">
							<twig:Button
								type="button"
								variant="ghost"
								size="sm"
								class="h-auto w-full justify-start rounded-sm border-0 bg-transparent px-2 py-1.5 text-left text-sm text-foreground hover:bg-accent hover:text-accent-foreground focus-visible:bg-accent focus-visible:text-accent-foreground"
								role="menuitem"
								data-modal-id="{{ action.modal }}"
								data-load-map="{{ action.load_map|default(false) ? 'true' : 'false' }}"
								onclick="document.getElementById('areaHeroMoreMenu').removeAttribute('open'); document.getElementById(this.dataset.modalId).showModal(); if (this.dataset.loadMap === 'true') window.MunichMapLoader?.loadAreaMap()"
							>
								<twig:ux:icon name="{{ action.icon }}" class="size-4 shrink-0" aria-hidden="true" />
								{{ action.label|trans() }}
							</twig:Button>
						</li>
					{% endfor %}
				</ul>
			</div>
		</details>
	</div>
