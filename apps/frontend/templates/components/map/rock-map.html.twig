{% set marker = [] %}
{% for rock in rocks %}
	{% set rockLink = rock_path(areaSlug, slug) %}
	{% set mapPopupHtml %}
		{% include 'components/map/rock-map-popup.html.twig' with {
			rock: rock,
			areaName: areaName,
			rockLink: rockLink,
			map_compact: true,
			show_chart: false,
			popupBody: ''
		} only %}
	{% endset %}
	{% set mapPopupHtml = mapPopupHtml|trim %}
	{% set marker = marker|merge([ rock.rockLat, rock.rockLng, rock.pathCoordinates, mapPopupHtml, rock.rockZoom ]) %}
{% endfor %}
{% set parkingIconHtml %}
	<twig:ux:icon name="lucide:square-parking" class="size-6 shrink-0 text-black" aria-hidden="true" />
{% endset %}
{% set rockIconHtml %}
	<twig:ux:icon name="lucide:mountain" class="size-6 shrink-0 text-black" aria-hidden="true" />
{% endset %}
{# Outside #rockMap: Leaflet replaces the map container contents and would drop icons placed inside. #}
<script type="application/json" id="rock-map-parking-icon-json">{{ parkingIconHtml|trim|json_encode|raw }}</script>
<script type="application/json" id="rock-map-target-icon-json">{{ rockIconHtml|trim|json_encode|raw }}</script>
<div
	id="rockMap"
	class="z-10 mb-3 w-full min-h-[12rem]"
	style="aspect-ratio: 16/16;"
	data-controller="rock-map"
	data-rock-map-payload="{{ marker|json_encode|e('html_attr') }}"
>
</div>
