{# Horizontal grade cells for area rocks listing only. Columns 3–11 = UIAA chart buckets from the API (sport + Fontainebleau FB …); Proj. optional. #}
{% set include_proj = include_projects_column|default(true) %}
{% set proj_n = project_count|default(0) %}
{% set route_total = rock.amountRoutes|default(0) %}
{% set strip_bg = {
	3: 'background-color: var(--grade-bucket-3);',
	4: 'background-color: var(--grade-bucket-4);',
	5: 'background-color: var(--grade-bucket-5);',
	6: 'background-color: var(--grade-bucket-6);',
	7: 'background-color: var(--grade-bucket-7);',
	8: 'background-color: var(--grade-bucket-8);',
	9: 'background-color: var(--grade-bucket-9);',
	10: 'background-color: var(--grade-bucket-10);',
	11: 'background-color: var(--grade-bucket-11);',
} %}
{% set strip_text_on_color = 'text-white' %}
{% set segments = [] %}
{% for g in 3..11 %}
	{% set n = attribute(rock, 'grade_chart_' ~ g)|default(0) %}
	{% if n > 0 %}
		{% set segments = segments|merge([{ kind: 'grade', g: g, n: n }]) %}
	{% endif %}
{% endfor %}
{% if include_proj and proj_n > 0 %}
	{% set segments = segments|merge([{ kind: 'proj', n: proj_n }]) %}
{% endif %}
{% set aria_parts = [] %}
{% for seg in segments %}
	{% if seg.kind == 'grade' %}
		{% set aria_parts = aria_parts|merge(['Grad ' ~ seg.g ~ ': ' ~ seg.n]) %}
	{% else %}
		{% set aria_parts = aria_parts|merge(['Projekte: ' ~ seg.n]) %}
	{% endif %}
{% endfor %}
{% set aria_label = aria_label_prefix|default('') ~ 'Routen je Gradstufe. ' ~ aria_parts|join('; ') %}
{% if route_total > 0 and segments is not empty %}
	<div class="not-prose w-full min-w-0">
		<div class="flex w-full min-w-0 gap-[2px]">
			<div
				class="flex w-6 shrink-0 flex-col items-start justify-end dark:text-white"
				title="Summe: {{ route_total }}"
			>
				<span class="mb-[1px] text-[14px] font-normal leading-none tabular-nums">{{ route_total }}</span>
			</div>
			<div class="min-w-0 flex-1">
				<div class="mb-[2px] flex text-center text-[11px] font-normal leading-none tabular-nums text-gray-900 dark:text-gray-300 pointer-events-none" aria-hidden="true">
					{% for seg in segments %}
						{% set amt_divider = not loop.first ? ' border-l border-black/[0.08] dark:border-white/[0.12]' : '' %}
						<div class="min-w-0 flex-1 px-px{{ amt_divider }}">{{ seg.n }}</div>
					{% endfor %}
				</div>
				<div
					class="flex h-4 w-full overflow-hidden rounded"
					role="img"
					aria-label="{{ aria_label|e('html_attr') }}"
				>
					{% for seg in segments %}
						{% set seg_divider = not loop.first ? ' border-l border-white/25 dark:border-black/20' : '' %}
						{% if seg.kind == 'grade' %}
							<div
								class="flex min-w-0 flex-1 items-center justify-center px-px text-center text-[10px] font-light leading-none tabular-nums{{ seg_divider }} {{ strip_text_on_color }}"
								style="{{ strip_bg[seg.g] }}"
								title="Grad {{ seg.g }}: {{ seg.n }}"
							>
								{{ seg.g }}
							</div>
						{% else %}
							<div
								class="flex min-w-0 flex-1 items-center justify-center px-px text-center text-[10px] font-light leading-none{{ seg_divider }} text-white"
								style="background-color: var(--grade-project);"
								title="{{ 'projects'|trans }}: {{ seg.n }}"
							>
								Proj.
							</div>
						{% endif %}
					{% endfor %}
				</div>
			</div>
		</div>
	</div>
{% endif %}
