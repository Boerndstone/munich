{# Expects: groupedRoutes, rocks (for topo image alt) #}
<div class="mx-auto w-full max-w-[1024px] px-2 sm:px-4" {{ stimulus_controller('grade-labels') }}>
	<div class="w-full md:w-3/4">
	{% for topoName, topoData in groupedRoutes %}
		{% set topo_id = topoName|custom_replace|lower %}
		<div class="mt-3 overflow-hidden rounded-none border-0 bg-[var(--theme-bg-lighter)] text-[var(--theme-text)]" id="{{ topo_id }}" data-topo-card>
			<section class="p-0" data-controller="route-information-tooltip">
				{% if topoData.topoImage is not empty and topoData.topoPathCollection is not empty %}
					{% set srcsetData = topoData.topoImage|topo_image_srcset %}
					{% set viewBoxValue = '0 0 1024 820' %}
					{% set aspectRatio = viewBoxValue|viewbox_to_aspect_ratio %}
					{% set pathsSvg = topo_paths_overlay(topoData.topoPathCollection, null) %}
					{% if pathsSvg is not empty %}
					<div class="topo-two-layer" data-topo-state="{{ loop.first ? 'ready' : 'loading' }}" aria-busy="false"{% if aspectRatio %} style="aspect-ratio: {{ aspectRatio }};"{% endif %}>
						<div class="topo-two-layer__loader" aria-hidden="true">
							<div class="topo-two-layer__loader-stack">
								<twig:Skeleton class="topo-two-layer__skeleton topo-two-layer__skeleton--hero" />
								<div class="topo-two-layer__skeleton-lines">
									<twig:Skeleton class="topo-two-layer__skeleton topo-two-layer__skeleton--line topo-two-layer__skeleton--line-lg" />
									<twig:Skeleton class="topo-two-layer__skeleton topo-two-layer__skeleton--line topo-two-layer__skeleton--line-sm" />
								</div>
							</div>
						</div>
						<p class="sr-only" data-topo-loading-status role="status" aria-live="polite" hidden>{{ 'search_modal.loading'|trans }} {{ topoName }}</p>
						<img
							class="topo-two-layer__bg"
							{% if loop.first %}
								src="{{ srcsetData.src|default(topoData.topoImage) }}"
								{% if srcsetData.srcset %}srcset="{{ srcsetData.srcset }}"{% endif %}
								{% if srcsetData.sizes %}sizes="{{ srcsetData.sizes }}"{% endif %}
								loading="eager"
								fetchpriority="high"
								data-topo-loaded="true"
								data-topo-status="ready"
							{% else %}
								src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=="
								data-topo-src="{{ srcsetData.src|default(topoData.topoImage) }}"
								{% if srcsetData.srcset %}data-topo-srcset="{{ srcsetData.srcset }}"{% endif %}
								{% if srcsetData.sizes %}data-topo-sizes="{{ srcsetData.sizes }}"{% endif %}
								loading="lazy"
								fetchpriority="low"
								data-topo-status="loading"
							{% endif %}
							data-topo-image
							alt="{{ 'topo.image_alt'|trans({ '%topo_name%': topoName, '%rock_name%': (rocks|first).rockName|default(''), '%area_name%': (rocks|first).areaName|default('') }) }}"
							decoding="async"
						>
						<div class="topo-two-layer__overlay" aria-hidden="true">
							<svg height="100%" width="100%" viewBox="{{ viewBoxValue }}" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" class="h-auto max-w-full preserve-aspect-ratio">
								{{ pathsSvg|raw }}
							</svg>
						</div>
					</div>
					{% endif %}
				{% endif %}
				<div class="relative w-full overflow-x-auto">
					<table class="w-full caption-bottom border-collapse border-b border-[var(--theme-border)] text-sm font-medium leading-tight text-[var(--theme-text)]">
						<tbody>
							{% for route in topoData.routes %}
								{% set rg = route.routeGrade|default('') %}
								{% set isFontGrade = rg|trim|upper|slice(0, 3) == 'FB ' %}
								<tr id="{{ route.routeName|replace({' ': ''})|lower }}" class="border-b border-[var(--theme-border)] transition-colors hover:bg-[var(--theme-bg)]/50" data-route-id="{{ loop.index }}" data-route-name="{{ route.routeName|e('html_attr') }}" data-route-grade-stored="{{ rg|e('html_attr') }}"{% if isFontGrade %} data-route-grade-fixed="1"{% endif %}>
									<td class="px-2 py-1 align-middle lg:px-2.5">
										<span>{{ loop.index }}</span>
									</td>
									<td class="px-2 py-1 align-middle lg:min-w-0 lg:whitespace-nowrap lg:px-2.5">
										<div class="flex min-w-0 flex-wrap items-center gap-x-1 lg:flex-nowrap lg:gap-y-0">
											<span class="min-w-0 max-w-full shrink font-medium lg:truncate" title="{{ route.routeName }}">{{ route.routeName }}</span>
											{{ include('components/route/params-icons.html.twig', {
												route_rating: route.routeRating,
												route_protection: route.routeProtection,
												route_rock_quality: route.rockQuality,
											}) }}
											{% if route.routeClimbingStyle is defined and route.routeClimbingStyle is not null and 'multi-pitch' in (route.routeClimbingStyle|default('[]')) %}
												<twig:ux:icon name="lucide:arrow-up-1-0" class="size-4" aria-hidden="true" title="Mehrseillängen Tour" aria-label="Mehrseillängen Tour" />
											{% elseif route.routeClimbingStyle is defined and route.routeClimbingStyle is not null and 'crack' in (route.routeClimbingStyle|default('[]')) %}
												<span class="ms-1 inline-block shrink-0 crack-climbing" title="Riss" role="img" aria-label="Riss"></span>
											{% endif %}
											{% if route.videoLink is not empty %}
												<a href="{{ route.videoLink }}" class="ms-0.5 inline-flex shrink-0 text-[var(--theme-text)] hover:opacity-80" title="Video von Route {{ route.routeName }} " target="_blank" rel="noopener noreferrer">
													<twig:ux:icon name="lucide:tv-minimal-play" class="size-4" aria-hidden="true" />
												</a>
											{% endif %}
										</div>
									</td>
									<td class="px-2 py-1 align-middle lg:px-2.5">
										{% if isFontGrade %}
											<span data-route-grade-fixed="true">{{ rg }}</span>
										{% else %}
											<span data-route-grade-label data-route-grade-stored="{{ rg|e('html_attr') }}">{{ rg }}</span>
										{% endif %}
									</td>
									<td class="hidden whitespace-nowrap px-2 py-1 align-middle lg:table-cell lg:px-2.5">
										<span>{{ route.routefirstAscent }}
											{% if route.routeyearFirstAscent %}
												{{ route.routeyearFirstAscent }}
											{% endif %}
										</span>
									</td>
									{# Fixed width + slot height so rows with/without comment button share the same column box #}
									<td class="box-border w-11 min-w-11 max-w-11 shrink-0 px-2 py-1 align-middle lg:w-12 lg:min-w-12 lg:max-w-12">
										<div class="flex h-7 items-center justify-end">
											{% if route.routeComment is not empty %}
												<twig:Dialog id="route-information-{{ topo_id }}-{{ loop.index }}">
													<twig:Dialog:Trigger>
														<twig:Button
															type="button"
															variant="ghost"
															size="icon-sm"
															class="m-0 shrink-0 rounded-full text-[var(--theme-text)] hover:bg-[var(--theme-bg-lighter)]"
															aria-label="{{ 'route.info_dialog_label'|trans({ '%name%': route.routeName }, 'messages') }}"
														>
															<twig:ux:icon name="lucide:info" class="size-4" aria-hidden="true" />
														</twig:Button>
													</twig:Dialog:Trigger>
													<twig:Dialog:Content class="w-full max-w-lg">
														<twig:Dialog:Header class="border-b border-[var(--theme-border)] pb-3 text-left">
															<twig:Dialog:Title>{{ route.routeName }}{% if rg %} ({{ rg }}){% endif %}</twig:Dialog:Title>
															{% if route.routefirstAscent or route.routeyearFirstAscent %}
																<twig:Dialog:Description>
																	{{ 'rock.routes_table.first_ascent'|trans }}: {{ route.routefirstAscent }}{% if route.routeyearFirstAscent %} {{ route.routeyearFirstAscent }}{% endif %}
																</twig:Dialog:Description>
															{% endif %}
														</twig:Dialog:Header>
														<div class="max-h-[min(70vh,28rem)] overflow-y-auto text-left text-sm text-[var(--theme-text)]">
															{% for comment in route.routeComment %}
																<p class="mt-2 font-normal">{{ comment.comment|raw }}</p>
																{% if comment.username %}
																	<p class="mt-2 font-normal italic text-gray-600 dark:text-gray-400">{{ comment.username }}{% if comment.date %} {{ comment.date|date('d.m.Y') }}{% endif %}</p>
																{% endif %}
																{% if not loop.last %}
																	<hr class="my-3 border-0 border-t border-[var(--theme-border)]">
																{% endif %}
															{% endfor %}
														</div>
													</twig:Dialog:Content>
												</twig:Dialog>
											{% endif %}
										</div>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</section>
		</div>
	{% endfor %}
	</div>
</div>
