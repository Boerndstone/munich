{% set railwayStation = areaRailwayStation %}
{% set map_attribute_filters = [
	{
		attr: 'childFriendly',
		icon: 'lucide:baby',
		trans_key: 'rocks.filter.child_friendly',
	},
	{
		attr: 'sunny',
		icon: 'lucide:sun',
		trans_key: 'rocks.filter.sunny',
	},
	{
		attr: 'rain',
		icon: 'lucide:umbrella',
		trans_key: 'rocks.filter.rain_shelter',
	},
	{
		attr: 'train',
		icon: 'lucide:train-front',
		trans_key: 'train.reachable',
	},
	{
		attr: 'bike',
		icon: 'lucide:bike',
		trans_key: 'bike.reachable',
	},
] %}
{% set map_infrastructure_filters = [
	{
		layer: 'sleep',
		data_keys: 'campingSites,accommodationSites,sleepingSites',
		icon: 'lucide:bed-double',
		trans_key: 'map.infrastructure.sleep',
		available: railwayStation.campingSites|default([]) is not empty or railwayStation.accommodationSites|default([]) is not empty or railwayStation.sleepingSites|default([]) is not empty,
	},
	{
		layer: 'railway',
		data_keys: 'trainStations',
		icon: 'lucide:train-front',
		trans_key: 'map.infrastructure.railway',
		available: railwayStation.trainStations|default([]) is not empty,
	},
	{
		layer: 'swimming',
		data_keys: 'swimmingSites',
		icon: 'lucide:waves',
		trans_key: 'map.infrastructure.swimming',
		available: railwayStation.swimmingSites|default([]) is not empty,
	},
	{
		layer: 'museum',
		data_keys: 'museumSites',
		icon: 'lucide:landmark',
		trans_key: 'map.infrastructure.museum',
		available: railwayStation.museumSites|default([]) is not empty,
	},
] %}

<div 
	class="main-map-container relative flex min-h-0 flex-1 flex-col"
	data-controller="map" 
	data-map-data-url-value="{{ path(app.request.locale == 'en' ? 'area_map_data_en' : 'area_map_data', { slug: areaSlug }) }}"
	data-map-zoom-value="{{ [areaLat, areaLng, areaZoom]|json_encode|e('html_attr') }}"
	data-map-error-text="{{ 'map.data_load_error'|trans|e('html_attr') }}"
	data-map-retry-text="{{ 'map.retry'|trans|e('html_attr') }}"
>
	<div class="area-map-filters shrink-0 space-y-1.5 px-3 py-2">
		<div class="main-map-filters-scroll" role="group" aria-labelledby="area-map-rock-filters-label">
			<ul class="main-map-filters-list">
				<li id="area-map-rock-filters-label" class="main-map-filters-label">{{ 'map.filters.rocks'|trans }}:</li>
				<li>
					<button type="button" class="flex items-center justify-center py-1 main-map-filter-tab main-map-filter-tab-icon active" data-map-target="layerBtn" data-layer="rocks" aria-pressed="true" title="{{ 'map.rocks.all'|trans }}" aria-label="{{ 'map.rocks.all'|trans }}">
						<twig:ux:icon name="lucide:mountain" class="size-4 shrink-0" aria-hidden="true" />
					</button>
				</li>
				{% for filter in map_attribute_filters %}
					{% set filter_label = filter.trans_key|trans %}
					<li>
						<button
							type="button"
							class="flex items-center justify-center py-1 main-map-filter-tab main-map-filter-tab-icon"
							data-map-target="attrFilterBtn"
							data-attr="{{ filter.attr }}"
							aria-pressed="false"
							title="{{ filter_label }}"
							aria-label="{{ filter_label }}"
						>
							<twig:ux:icon name="{{ filter.icon }}" class="size-4 shrink-0" aria-hidden="true" />
						</button>
					</li>
				{% endfor %}
			</ul>
		</div>
		<div class="main-map-filters-scroll" role="group" aria-labelledby="area-map-infrastructure-filters-label">
			<ul class="main-map-filters-list">
				<li id="area-map-infrastructure-filters-label" class="main-map-filters-label">{{ 'map.filters.infrastructure'|trans }}:</li>
				{% for filter in map_infrastructure_filters %}
					{% if filter.available %}
						{% set filter_label = filter.trans_key|trans %}
						<li>
							<button
								type="button"
								class="flex items-center justify-center py-1 main-map-filter-tab main-map-filter-tab-icon"
								data-map-target="layerBtn"
								data-layer="{{ filter.layer }}"
								data-information-keys="{{ filter.data_keys }}"
								data-popup-label="{{ filter_label }}"
								data-popup-address-label="{{ 'map.details.address'|trans }}"
								data-popup-description-label="{{ 'map.details.description'|trans }}"
								data-popup-opening-hours-label="{{ 'map.details.opening_hours'|trans }}"
								data-popup-phone-label="{{ 'map.details.phone'|trans }}"
								data-popup-link-label="{{ 'map.details.website'|trans }}"
								aria-pressed="false"
								title="{{ filter_label }}"
								aria-label="{{ filter_label }}"
							>
								<twig:ux:icon name="{{ filter.icon }}" class="size-4 shrink-0" aria-hidden="true" />
							</button>
						</li>
					{% endif %}
				{% endfor %}
			</ul>
		</div>
	</div>
	<div class="absolute inset-x-3 top-3 z-[1000] hidden rounded-md border border-border bg-background p-3 text-sm text-foreground shadow-md" data-map-target="error" role="status" aria-live="polite">
		<p class="mb-2" data-map-target="errorMessage"></p>
		<button type="button" class="rounded-md border border-border bg-background px-3 py-1.5 font-medium hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" data-map-target="retry" data-action="click->map#retryData">{{ 'map.retry'|trans }}</button>
	</div>
	<div class="min-h-0 flex-1" data-map-target="map"></div>
</div>
