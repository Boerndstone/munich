{# @prop id string HTML id on the native `<dialog>` (pair with `aria-controls` on the trigger). #}
{# @prop side 'left'|'right' The side from which the Sheet panel opens. Defaults to `left` #}
{# @block content Sheet panel content #}
{%- props id, side = 'left' -%}
{%- set side_classes = side == 'right' ? 'right-0 border-l' : 'left-0 border-r' -%}

<dialog
	id="{{ id }}"
	class="fixed inset-0 z-[1055] m-0 h-dvh max-h-none w-screen max-w-none border-0 bg-transparent p-0 open:block open:backdrop:bg-black/40"
	{{ attributes.defaults({
		'aria-modal': 'true',
		'data-sheet-target': 'dialog',
		'data-action': 'click->sheet#closeOnClickOutside keydown.esc->sheet#close:prevent',
		'data-side': side,
	}).without('class', 'id') }}
>
	<aside
		class="{{ ('absolute inset-y-0 flex w-[min(100vw,20rem)] max-w-full flex-col overflow-y-auto bg-background text-foreground shadow-xl ' ~ side_classes ~ ' ' ~ attributes.render('class'))|tailwind_merge }}"
		data-sheet-panel
	>
		{%- block content %}{% endblock -%}
	</aside>
</dialog>
